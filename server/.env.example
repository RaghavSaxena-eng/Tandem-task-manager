PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string for production
MONGODB_URI=mongodb://127.0.0.1:27017/collab-task-manager
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (CORS + Socket.io)
CLIENT_URL=http://localhost:5173
